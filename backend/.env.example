# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=5000

API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000


# ==========================================
# DATABASE
# ==========================================

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"


# ==========================================
# AUTHENTICATION
# ==========================================

JWT_ACCESS_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ==========================================
# EMAIL
# ==========================================

EMAIL_FROM="Dayflow HRMS <noreply@yourdomain.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Used for verification/reset links
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password


# ==========================================
# FILE STORAGE
# ==========================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ==========================================
# SECURITY
# ==========================================

BCRYPT_SALT_ROUNDS=12

# Protect HR/Admin registration
HR_SIGNUP_INVITE_CODE=


# ==========================================
# OPTIONAL APPLICATION SETTINGS
# ==========================================

ATTENDANCE_TIMEZONE=Asia/Kolkata